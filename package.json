{
  "name": "aria-ng-cli",
  "version": "0.1.0",
  "description": "Serve the official AriaNg release from a small Node.js CLI.",
  "keywords": [
    "aria2",
    "ariang",
    "cli",
    "http-server"
  ],
  "license": "MIT",
  "bin": {
    "aria-ng": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "vendor/ariang/",
    "vendor/ariang.manifest.json",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "check": "pnpm format:check && pnpm lint && pnpm lint:type-aware && pnpm typecheck && pnpm test && pnpm verify:ariang",
    "format": "oxfmt --ignore-path .oxfmtignore --write .",
    "format:check": "oxfmt --ignore-path .oxfmtignore --check .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "lint:type-aware": "oxlint --type-aware",
    "pack:test": "tsx scripts/pack-test.ts",
    "prepack": "pnpm build && pnpm verify:ariang",
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "sync:ariang": "tsx scripts/sync-ariang.ts",
    "test": "tsx --test",
    "typecheck": "tsc --noEmit",
    "verify:ariang": "tsx scripts/verify-ariang.ts"
  },
  "dependencies": {
    "open": "11.0.1",
    "sirv": "3.0.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "22.20.0",
    "extract-zip": "2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "only-allow": "1.2.2",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "0.22.14",
    "tsx": "4.23.12",
    "typescript": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "ariangVersion": "1.3.14"
}
